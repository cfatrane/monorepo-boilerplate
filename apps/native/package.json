    "@repo/ui": "*",
    "expo": "^55.0.4",
    "expo-blur": "~55.0.14",
    "expo-constants": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.3",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
